# Copy to .env and fill in. Secrets never get committed (docs/02).

# CockroachDB connection string.
#   Cloud:  Cloud Console → Connect
#   Local:  postgresql://root@localhost:26257/defaultdb?sslmode=disable
# The least-privilege application role is recall_app (infra/migrations/0003) — use it
# for anything that runs the agent; root is for migrations only.
CRDB_CONN_STRING=postgresql://USER:PASS@HOST:26257/defaultdb?sslmode=verify-full

# Bedrock — record the verified model ids the day the probe runs (docs/04 version policy)
BEDROCK_MODEL_ID=
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
AWS_REGION=us-east-1

# Embedding width (decision D1). Must equal VECTOR(n) in infra/schema.sql — the two
# move together in one commit or every distance silently lies.
EMBED_DIM=1024

# Confidence thresholds (AC13) — tuned once in P1 against the seeded corpus, then
# frozen. Left blank on purpose until that tuning happens: blank parses as NaN, every
# comparison against NaN is False, and the bands stay unusable rather than silently
# labelling everything 'high'. (Blank and unset behave identically — tools.py uses
# `or`, not a get() default, so neither detonates at import.)
CONFIDENCE_HIGH_MAX_DIST=
CONFIDENCE_NONE_MIN_DIST=

# Decay re-rank half-life (docs/02)
DECAY_HALF_LIFE_DAYS=90
